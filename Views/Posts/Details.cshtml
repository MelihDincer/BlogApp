@model Post

<div class="row">
    <div class="col-lg-8">
        <div class="bg-white p-4">
            <h1 class="h4 mb-4">@Model.Title</h1>
            <div class="tags">
                @foreach(var tag in Model.Tags)
                {
                    <a href="/posts/tag/@tag.Url" class="badge bg-@tag.Color bg-opacity-10 text-@tag.Color mb-2 fw-bold ">
                        <i class="bi bi-tags"></i>
                        @tag.Text</a>
                }
                
            </div>
            <img src="~/img/@Model.Image" class="img-fluid mb-4" alt=""/>
            <div class="content">
                @Model.Content
            </div>
        </div>
        <div class ="bg-white mt-3">
            <div class="card border-0">
                <div class="card-header pb-0">
                    <h4>@Model.Comments.Count() Yorum</h4>
                </div>
                <div class="card-body">
                    @foreach(var comment in Model.Comments)
                    {
                    <div class="my-4 d-flex">
                        <img class="avatar rounded-circle float-start me-3" src="~/img/@comment.User.Image"/>
                        <div class="mb-2">
                            <h6 class="fw-bold">@comment.User.UserName</h6>
                            <p class="text-muted small">@comment.PublishedOn.ToString("dd MMMM yyyy HH:mm")</p>
                            <p>@comment.Text</p>
                        </div>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <vc:tags-menu></vc:tags-menu>
        <vc:new-posts></vc:new-posts>
    </div>
</div>

    
